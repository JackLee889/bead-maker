{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Bead Maker (F5)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "pythonArgs": ["-Xfrozen_modules=off"],
      "cwd": "${workspaceFolder}",
      "args": [
        "run",
        "app.py",
        "--server.address",
        "127.0.0.1",
        "--server.port",
        "8501",
        "--server.headless",
        "false",
        "--browser.gatherUsageStats",
        "false"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Attach to debug_windows.bat",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": 5678
      },
      "justMyCode": true
    }
  ]
}
